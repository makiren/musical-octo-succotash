# Finnhub API key — get a free one at https://finnhub.io/dashboard
# When this is unset, the app serves realistic mock data so you can still
# explore every feature without a key.
FINNHUB_API_KEY=

# Optional: comma-separated symbols used to seed the default watchlist.
NEXT_PUBLIC_DEFAULT_WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL

# Optional: directory where watchlist/portfolio/alerts are persisted on the
# server (survives restarts). Defaults to ./.data when unset.
DATA_DIR=
